# Frontend environment variables (Vite)
# Copy this file to .env.local for local development.
# For production hosting, configure the same keys in your build/deploy environment.

# Backend HTTP API base URL
VITE_API_BASE_URL=http://localhost:8080

# Backend WebSocket base URL
# If omitted, frontend will reuse VITE_API_BASE_URL.
VITE_WS_BASE_URL=http://localhost:8080

# Production example:
# VITE_API_BASE_URL=https://api.your-domain.com
# VITE_WS_BASE_URL=https://api.your-domain.com
# If frontend is HTTPS (Vercel), prefer HTTPS backend to avoid mixed-content blocking.
