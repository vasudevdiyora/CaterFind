# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# The .env file is gitignored and will not be committed.
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/caterfind?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ============================================================
# TWILIO CONFIGURATION
# ============================================================
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ============================================================
# EXOTEL CONFIGURATION
# ============================================================
# Get credentials from: https://my.exotel.com/
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_SUBDOMAIN=api
EXOTEL_CALLER_ID=your_phone_number

# ============================================================
# OPENAI CONFIGURATION (For Translation)
# ============================================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-3.5-turbo
