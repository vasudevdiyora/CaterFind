# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# The .env file is gitignored and will not be committed.
# ============================================================

# ============================================================
# APP / PROFILE CONFIGURATION
# ============================================================
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SERVER_ADDRESS=0.0.0.0
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
APP_ERRORS_INCLUDE_STACKTRACE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_production

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/caterfind?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SQL_INIT_MODE=never

# ============================================================
# TWILIO CONFIGURATION
# ============================================================
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_CALLBACK_URL=https://your-domain.com/api/calls/status

# Calling provider: twilio or exotel
APP_CALLING_PROVIDER=twilio

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ============================================================
# EXOTEL CONFIGURATION
# ============================================================
# Get credentials from: https://my.exotel.com/
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_SUBDOMAIN=api
EXOTEL_CALLER_ID=your_phone_number
EXOTEL_APPLET_ID=

# ============================================================
# OPENAI CONFIGURATION (For Translation)
# ============================================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-3.5-turbo

# ============================================================
# FILE UPLOAD / CLEANUP CONFIGURATION
# ============================================================
FILE_UPLOAD_DIR=uploads/images
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
CALENDAR_CLEANUP_ENABLED=true
CALENDAR_CLEANUP_RETENTION_DAYS=30
CALENDAR_CLEANUP_CRON=0 0 2 * * ?

# ============================================================
# SECURITY CONFIGURATION (JWT + OTP)
# ============================================================
JWT_SECRET=replace-with-a-long-random-secret-32-bytes-minimum
JWT_EXPIRATION_MINUTES=60
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-a-strong-otp-pepper
